  "constraints": [],
  "schemaVersion": 1,
  "propsJsonSchema": {
    "type": "object",
    "required": [
      "root"
    ],
    "properties": {
      "root": {
        "type": "object",
        "description": "Nodo raíz del árbol (estructura libre, se renderiza recursivamente)"
      },
      "fontSize": {
        "type": "number",
        "default": 26,
        "maximum": 40,
        "minimum": 22
      },
      "nodeRadius": {
        "type": "number",
        "default": 28,
        "maximum": 60,
        "minimum": 15
      },
      "showLabels": {
        "type": "boolean",
        "default": true
      },
      "orientation": {
        "enum": [
          "horizontal",
          "vertical"
        ],
        "type": "string",
        "default": "horizontal"
      },
      "branchLength": {
        "type": "number",
        "default": 220,
        "maximum": 400,
        "minimum": 100
      },
      "highlightPath": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "IDs de nodos a resaltar"
      },
      "showProbabilities": {
        "type": "boolean",
        "default": true
      }
    }
  }
