  "title": "Venn Diagram",
  "status": "stable",
  "purpose": "Render a two‑set Venn diagram with labeled region counts (only A, only B, intersection, neither) for immediate visual interpretation of set relationships.",
  "runtime": "sandboxed",
  "version": "1.0.0",
  "examples": [
    {
      "name": "ejemplo1",
      "props": {
        "setA": "Estudiantes con laptop",
        "setB": "Estudiantes con tablet",
        "onlyA": 12,
        "onlyB": 8,
        "neither": 3,
        "intersection": 5
      }
    },
    {
      "name": "ejemplo2",
      "props": {
        "setA": "Usuarios de Android",
        "setB": "Usuarios de iOS",
        "onlyA": 45,
        "onlyB": 30,
        "neither": 15,
        "intersection": 10
      }
    }
  ],
  "useCases": [
    "Illustrate survey results with two categorical questions",
    "Show overlap of student groups in a classroom activity",
    "Compare features of two products in a decision‑making slide",
    "Teach basic set theory concepts with concrete numbers"
