  "fitsSlots": [
    "visual",
    "main",
    "right",
    "left",
    "text"
  ],
  "bundleHash": "2d9d69759a315d474e7b6d08f18b013c57c6cbe39d0618237178d22017d2ddfc",
  "constraints": [],
  "schemaVersion": 1,
  "propsJsonSchema": {
    "type": "object",
    "required": [
      "setA",
      "setB",
      "onlyA",
      "onlyB",
      "intersection",
      "neither"
    ],
    "properties": {
      "setA": {
        "type": "string",
        "maxLength": 30,
        "description": "Label for the left set"
      },
      "setB": {
        "type": "string",
        "maxLength": 30,
        "description": "Label for the right set"
      },
      "onlyA": {
        "type": "integer",
        "minimum": 0,
        "description": "Count of elements only in set A"
      },
      "onlyB": {
        "type": "integer",
        "minimum": 0,
        "description": "Count of elements only in set B"
      },
      "neither": {
        "type": "integer",
        "minimum": 0,
        "description": "Count of elements in neither set"
      },
      "intersection": {
        "type": "integer",
        "minimum": 0,
        "description": "Count of elements in both sets"
      }
    }
  }
