# ───────── Lámina: variables de entorno (sin secretos reales) ─────────
# Web (apps/web) y worker/renderer comparten la base de datos y el volumen DATA_DIR.

NODE_ENV=development
AUTH_SIGNIN_MAX=6   # intentos de login por minuto por IP
# AUTH_RATE_LIMIT=off   # SOLO en pruebas E2E: desactiva el rate limit de Better Auth
DATABASE_URL=postgres://lamina:lamina@127.0.0.1:55432/lamina
APP_URL=http://localhost:3100
DATA_DIR=./data

# Auth (Better Auth). Genera con: openssl rand -base64 48
BETTER_AUTH_SECRET=cambia-esto-por-un-secreto-largo-aleatorio-de-48-bytes
# Correos con rol admin (entran por Keycloak). Separados por coma.
ADMIN_EMAILS=esteban.morocho@cupula.com.ec
# Google (opcional): solo permite entrar a cuentas ya dadas de alta por un admin.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Keycloak (opcional): acceso del admin vía SSO de Cúpula.
KEYCLOAK_ISSUER=https://auth.cupula.com.ec/realms/cupula
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=

# Correo (alta de docentes con contraseña temporal). Sin SMTP_HOST en desarrollo se imprime en consola.
SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Lámina <noreply@cupula.com.ec>"

# IA — SOLO modelos :free de OpenRouter (gasto 0 USD; el guard rechaza cualquier otro).
# Usa una clave dedicada con límite de crédito 0.
LAMINA_AI_PROVIDER=openrouter        # o "fake" (desarrollo/CI, determinista, sin red)
OPENROUTER_API_KEY=
AI_DAILY_BUDGET=800                  # llamadas IA/día en total (≈80 % del cupo free de 1000/día)
# Cadenas de modelos por rol (opcional, separados por coma y todos terminados en :free):
# LAMINA_MODELS_CONTENT=nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free

# Búsqueda web: SearXNG propio (principal) + Tavily (respaldo, plan gratuito).
SEARXNG_URL=http://127.0.0.1:58080
TAVILY_API_KEY=

# Servicios internos
RENDER_SERVICE_TOKEN=cambia-esto-token-de-servicio-24+caracteres   # web ↔ renderer
WEB_INTERNAL_URL=http://localhost:3100                              # renderer → web
SANDBOX_URL=http://localhost:8600                                   # worker → sandbox-runner
SANDBOX_TOKEN=cambia-esto-token-sandbox-24+caracteres

# PR automáticos al promover componentes (opcional; token con permiso de contenido y PR en el repo)
GITHUB_TOKEN=
GITHUB_REPO=cupula-ec/lamina
